#!/bin/sh
# tty1 kiosk 会话：启动 udev 合成器并托管 smoke；无头时日志进串口 hvc0。
export RUST_LOG="${RUST_LOG:-archoera_shell=info,warn}"
if [ -w /dev/hvc0 ]; then
    exec >/dev/hvc0 2>&1
fi

args=""
if [ -f /opt/archoera/session.args ]; then
    args="$(cat /opt/archoera/session.args)"
fi

while true; do
    echo "[session] 启动 udev kiosk $(date -Is) args='${args}'"
    # shellcheck disable=SC2086
    /opt/archoera/archoera-shell --backend udev $args -- /opt/archoera/archoera-smoke
    echo "[session] 合成器退出 rc=$?，5s 后重试"
    sleep 5
done
