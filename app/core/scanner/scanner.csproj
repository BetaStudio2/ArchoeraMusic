<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>archoera-scanner</AssemblyName>
    <RootNamespace>Archoera.Scanner</RootNamespace>
    <!-- 框架依赖发布（runtime 由运行时镜像提供，跨架构友好） -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 子项目 scanner-ffi 是独立 AOT 库，不得编入 CLI -->
    <Compile Remove="scanner-ffi/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- TagLibSharp: 音频元数据解析（MP3/FLAC/OGG/M4A/APE/WAV/DSF 等） -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!-- Microsoft.Data.Sqlite: 直写 SQLite，绕过 Node.js V8 堆 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, High): SQLitePCLRaw.lib.e_sqlite3
         <= 2.1.11 捆绑的 SQLite < 3.50.2 存在聚合项内存损坏，且无 2.1.x 补丁。
         显式 pin 原生库到 3.50.3（纯静态库包、无 managed 依赖），仅升级原生
         SQLite 二进制，managed 核心保持 2.x 与 Microsoft.Data.Sqlite 9 兼容。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
