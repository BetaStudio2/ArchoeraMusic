#!/bin/sh
# tty1 kiosk 会话（以默认用户 archoera 运行，非 root）：启动 udev 合成器并托管
# 会话客户端。DRM/输入设备经 libseat → systemd-logind 的 VT 会话授权。
# 优先拉起真实播放器（/opt/archoera-music/archoera_music），缺失时回退 smoke。
# 无头时日志进串口 hvc0。
#
# 会话内还负责：
# - 一个 session D-Bus（fcitx5 / libsecret 等需要）；
# - 输入法 fcitx5：其 Wayland 前端以 `zwp_input_method_v2` 接入合成器，
#   合成器把客户端 `zwp_text_input_v3` 的输入上下文转给它（smithay 桥接）。
#
# ⚠ 输入法生命周期必须与合成器**成对**（见下方 start_ime/stop_ime）：
#   smithay 0.7 的 input-method 桥接不支持热重连——已有一个 IME 实例时，第二个
#   实例会被 `add_instance` 拒之门外（只对旧实例发 unavailable、却不登记新实例），
#   结果是「换一个实例 = 输入法永久失效」。所以每次合成器重启都重建 fcitx5，
#   且绝不在合成器存活时替换它；合成器侧的 ime 看门狗发现 IME 断开也会主动退出，
#   由本脚本把两者一起重启。
export RUST_LOG="${RUST_LOG:-archoera_shell=info,warn}"
# 日志：无头（有串口）时进 hvc0；否则落家目录，便于 GUI 模式下事后排查。
if [ -w /dev/hvc0 ]; then
    exec >/dev/hvc0 2>&1
else
    LOG="${XDG_STATE_HOME:-$HOME/.local/state}/archoera-session.log"
    mkdir -p "$(dirname "$LOG")"
    exec >>"$LOG" 2>&1
fi

# 固定 socket 名，输入法才能确定连哪个 Wayland 显示。
SOCKET=wayland-archoera
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCKET_PATH="$RUNTIME_DIR/$SOCKET"

# 会话自述：便于确认「以普通用户 archoera + logind VT 会话」运行而非 root。
echo "[session] 用户=$(id -un) uid=$(id -u) home=$HOME runtime=${XDG_RUNTIME_DIR:-未设置}"
echo "[session] 会话=$(loginctl show-session "$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3==u {print $1; exit}')" -p Type -p Active -p Seat -p VTNr 2>/dev/null | tr '\n' ' ')"
echo "[session] fcitx5=$(command -v fcitx5 >/dev/null 2>&1 && echo 有 || echo 无)"

# 电源动作授权自检：logind 的 power-off/reboot/suspend/hibernate 由 polkit 判定，
# 活动会话默认 allow_active=yes（免鉴权）。无 polkit/非活动会话会显示「需鉴权」，
# 据此可直接定位「点了关机/重启没反应」。
if command -v pkcheck >/dev/null 2>&1; then
    for action in power-off reboot suspend hibernate; do
        if pkcheck --action-id "org.freedesktop.login1.$action" --process $$ >/dev/null 2>&1; then
            echo "[session] polkit 授权: $action = 允许"
        else
            echo "[session] polkit 授权: $action = 拒绝/需鉴权"
        fi
    done
fi

# session D-Bus（无 systemd 用户会话时手动拉起）。
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-daemon >/dev/null 2>&1; then
    DBUS_SESSION_BUS_ADDRESS="$(dbus-daemon --session --fork --print-address)"
    export DBUS_SESSION_BUS_ADDRESS
fi

# 光标主题：build.sh 已把宿主当前主题复制进镜像并写入 /opt/archoera/cursor-theme。
if [ -r /opt/archoera/cursor-theme ]; then
    CURSOR_THEME="$(sed -n '1p' /opt/archoera/cursor-theme)"
    CURSOR_SIZE="$(sed -n '2p' /opt/archoera/cursor-theme)"
    [ -n "$CURSOR_THEME" ] && export XCURSOR_THEME="$CURSOR_THEME"
    [ -n "$CURSOR_SIZE" ] && export XCURSOR_SIZE="$CURSOR_SIZE"
fi

# 音频：拉起 PipeWire + WirePlumber（+ PulseAudio 兼容层）。
# 播放引擎（miniaudio）走 PulseAudio 后端，**没有服务端就完全没声音**。
# live 环境里 logind 的 `systemd --user` 不一定可用，所以直接拉起进程（随会话退出），
# 并用 pgrep 兜底避免与已存在的实例重复启动。
start_audio() {
    if ! command -v pipewire >/dev/null 2>&1; then
        echo "[session] 未安装 pipewire，跳过音频服务端"
        return
    fi
    if ! pgrep -x pipewire >/dev/null 2>&1; then
        echo "[session] 启动 PipeWire"
        pipewire >/dev/null 2>&1 &
    fi
    i=0
    while [ "$i" -lt 50 ]; do
        [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0" ] && break
        i=$((i + 1))
        sleep 0.1
    done
    if command -v pipewire-pulse >/dev/null 2>&1 && ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
        echo "[session] 启动 pipewire-pulse（PulseAudio 兼容接口）"
        pipewire-pulse >/dev/null 2>&1 &
    fi
    if command -v wireplumber >/dev/null 2>&1 && ! pgrep -x wireplumber >/dev/null 2>&1; then
        echo "[session] 启动 WirePlumber（会话策略与设备管理）"
        wireplumber >/dev/null 2>&1 &
    fi
}
start_audio

# ── 输入法：与合成器成对生命周期 ────────────────────────────────────────────
# 当前实例的进程号（空 = 未运行）。
IME_PID=""

# 等合成器 socket **由本轮**创建。启动前已清掉陈旧 socket 文件，因此它出现即代表
# 新合成器已在监听（避免 fcitx5 抢在 socket 就绪前连接失败）。
wait_for_socket() {
    i=0
    while [ "$i" -lt 300 ]; do
        [ -S "$SOCKET_PATH" ] && return 0
        i=$((i + 1))
        sleep 0.1
    done
    return 1
}

# 启动 fcitx5：先确保没有上一轮残留实例，再以前台模式作为脚本子进程拉起。
# 不用 `--replace`：替换会在旧实例仍连接时触发 smithay 的实例登记缺陷。
start_ime() {
    if ! command -v fcitx5 >/dev/null 2>&1; then
        echo "[session] 未安装 fcitx5，跳过输入法"
        return 0
    fi
    # 清掉残留（上一轮异常退出、或手工启动的实例），避免两个实例并存。
    if pgrep -x fcitx5 >/dev/null 2>&1; then
        echo "[session] 发现残留 fcitx5，先清理"
        pkill -x fcitx5 2>/dev/null
        i=0
        while pgrep -x fcitx5 >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
            i=$((i + 1))
            sleep 0.1
        done
        pkill -9 -x fcitx5 2>/dev/null
    fi
    echo "[session] 启动输入法 fcitx5（Wayland 前端 → zwp_input_method_v2）"
    # 前台运行并置于后台（不用 -d 守护化），这样能拿到 PID 并随合成器一起收尾。
    WAYLAND_DISPLAY="$SOCKET" fcitx5 &
    IME_PID=$!
}

# 结束当前输入法实例，并等它真正退出（避免残留连上下一轮合成器）。
stop_ime() {
    [ -n "$IME_PID" ] || return 0
    if kill -0 "$IME_PID" 2>/dev/null; then
        kill "$IME_PID" 2>/dev/null
        i=0
        while kill -0 "$IME_PID" 2>/dev/null && [ "$i" -lt 20 ]; do
            i=$((i + 1))
            sleep 0.1
        done
        kill -9 "$IME_PID" 2>/dev/null
    fi
    IME_PID=""
}

# 脚本异常退出（tty 断开 / 被杀）时也收尾，避免孤儿合成器与输入法。
cleanup_on_exit() {
    [ -n "${SH_PID:-}" ] && kill "$SH_PID" 2>/dev/null
    stop_ime
}
# 终止信号统一转成正常退出，从而只走一次 EXIT 收尾。
trap cleanup_on_exit EXIT
trap 'exit 0' TERM INT HUP

args=""
if [ -f /opt/archoera/session.args ]; then
    args="$(cat /opt/archoera/session.args)"
fi
args="--socket $SOCKET $args"

APP=/opt/archoera-music/archoera_music
if [ -x "$APP" ]; then
    client="$APP"
else
    client=/opt/archoera/archoera-smoke
fi

# 播放器是 GTK3 客户端：强制 Wayland 后端。
# 输入法走 Wayland text-input-v3，因此不设 GTK_IM_MODULE（会走合成器 → fcitx5）。
export GDK_BACKEND=wayland
# ⚠ 不要无条件开软件渲染：这会让**合成器与播放器双双走 llvmpipe**。真机上的表现是
# 全屏合成掉到 ~18fps、一操作（点击/移动）就 100% CPU、完全不碰 GPU —— 那是早期
# 「virtio-gpu 无 virgl」的 VM 调试遗留。仅无 GPU 的 VM 测试用 ARCHOERA_SOFTWARE_GL=1
# 显式开启。
if [ "${ARCHOERA_SOFTWARE_GL:-0}" = "1" ]; then
    echo "[session] 按 ARCHOERA_SOFTWARE_GL=1 强制软件渲染（仅供无 GPU 的 VM）"
    export LIBGL_ALWAYS_SOFTWARE=1
fi
unset GTK_IM_MODULE

# 每轮都重新判定模式：安装向导交接靠「播放器写 /run/archoera-install/request 后退出
# → 合成器 watchdog 随之退出 → 这里把客户端换成同一二进制的安装向导模式」。
# ⚠ 判定必须在循环**内部**：写在循环外的话，播放器退出后循环只会再次拉起播放器，
# 请求永远不被看见（向导起不来）；放在循环内还能让向导异常退出时自动回到播放器。
#
# 模式用环境变量传递（Flutter 的 Linux runner 不会把 argv 透传给 Dart 的 main），
# 客户端环境由合成器继承，所以这里 export/unset 即可决定下一轮跑哪个模式。
while true; do
    MODE=player
    if [ -f /run/archoera-install/request ]; then
        rm -f /run/archoera-install/request
        if [ -x "$APP" ]; then
            MODE=installer
            echo "[session] 检测到安装向导请求 → 以 ARCHOERA_MODE=installer 启动客户端"
        fi
    fi
    if [ "$MODE" = "installer" ]; then
        export ARCHOERA_MODE=installer
    else
        unset ARCHOERA_MODE
    fi

    # 清掉上一轮可能残留的 socket（合成器已退出），使 wait_for_socket 只认本轮监听。
    rm -f "$SOCKET_PATH" "$SOCKET_PATH.lock"

    echo "[session] 启动 udev kiosk $(date -Is) args='${args}' client='${client}' mode='$MODE'"
    # shellcheck disable=SC2086
    /opt/archoera/archoera-shell --backend udev $args -- "$client" &
    SH_PID=$!

    if wait_for_socket; then
        start_ime
    else
        echo "[session] 等待合成器 socket 超时（合成器可能启动失败），跳过输入法"
    fi

    # 成对监视：合成器或输入法任一退出，都一起收尾再重开，绝不留半桥接状态。
    while :; do
        if ! kill -0 "$SH_PID" 2>/dev/null; then
            break
        fi
        if [ -n "$IME_PID" ] && ! kill -0 "$IME_PID" 2>/dev/null; then
            echo "[session] fcitx5 已退出，重启会话以重建输入法桥接"
            kill "$SH_PID" 2>/dev/null
            break
        fi
        sleep 0.5
    done

    wait "$SH_PID"
    rc=$?
    stop_ime
    echo "[session] 合成器退出 rc=$rc，5s 后重试"
    sleep 5
done
