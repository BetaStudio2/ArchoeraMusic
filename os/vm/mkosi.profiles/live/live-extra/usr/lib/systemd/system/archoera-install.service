# ArchoeraOS 安装到磁盘（仅 Live 镜像存在）：由向导写目标盘后 systemctl start。
[Unit]
Description=ArchoeraOS 安装到目标磁盘
ConditionPathExists=/etc/archoera-live
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=0
# 目标磁盘与全部选项由向导写入计划文件（目录归属 kiosk 用户）：
#   /run/archoera-install/plan     key=value（disk/hostname/locale/encrypt/fs/...）
#   /run/archoera-install/secrets  0600（luks_passphrase/user_password/root_password）
ExecStart=/usr/local/bin/archoera-install
