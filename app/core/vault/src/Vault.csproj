<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>archoera-vault</AssemblyName>
    <RootNamespace>Archoera.Vault</RootNamespace>
    <!-- 凭据保险库：按需会话进程（NativeAOT 单文件可执行，无 .NET 运行时依赖）；
         经 stdin/stdout 行协议与主进程通信（后续握手协议见 credential-vault-plan §3.8） -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <!-- macOS NativeAOT Swift 库链接（dotnet/runtime#125858）：
       根因①：.NET 10 的 macOS 默认部署目标 AppleMinOSVersion=12.0
       （Microsoft.NETCore.Native.Unix.targets），而 macOS-14/15 runner 的
       /usr/lib/swift 系统 Swift 运行时库（libswift_Builtin_float 等）minOS
       ≥ 13 → 链接器按版本拒绝。官方修复（PR #126893，.NET 11）把默认值
       提到 14.0；AppleMinOSVersion 是公开属性，.NET 10 上直接覆盖即可。
       根因②（#125858 主体）：Xcode 15 下 .NET 默认追加 -ld_classic
       （UseLdClassicXCodeLinker，Unix.targets 285 行），而经典链接器无法
       处理 pal_swiftbindings 的 Swift autolink（__swift_FORCE_LOAD_$_*
       符号，dotnet/runtime#124609 证实新链接器 ld_prime 有兼容逻辑、经典
       链接器没有）。禁用开关改用 ld_prime（Xcode 15 默认新链接器）。 -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <AppleMinOSVersion>14.0</AppleMinOSVersion>
    <UseLdClassicXCodeLinker>false</UseLdClassicXCodeLinker>
  </PropertyGroup>

  <!-- 兜底：候选 Swift 库目录（未来 runner 镜像 /usr/lib/swift 缺库时生效）。
       SDKROOT（SDK .tbd stub）与 SWIFT_TOOLCHAIN_LIB（toolchain macosx 目录）
       均由 build-macos.sh 显式注入；项目级 ItemGroup 静态求值，必然生效。
       ③下方 BeforeTargets 钩子为 SDKROOT 未设置时的最后兜底（运行时求值，
       存在时序脆弱性）。 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SDKROOT)' != ''">
    <LinkerArg Include="-L$(SDKROOT)/usr/lib/swift" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SWIFT_TOOLCHAIN_LIB)' != ''">
    <LinkerArg Include="-L$(SWIFT_TOOLCHAIN_LIB)" />
  </ItemGroup>

  <Target Name="AddSwiftLibraryPaths"
          BeforeTargets="LinkNative"
          Condition="$([MSBuild]::IsOSPlatform('osx')) and '$(SDKROOT)' == ''">
    <Exec Command="xcrun --show-sdk-path"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MacSdkPath" />
    </Exec>
    <ItemGroup>
      <LinkerArg Include="-L$(_MacSdkPath)/usr/lib/swift" />
    </ItemGroup>
  </Target>

</Project>
