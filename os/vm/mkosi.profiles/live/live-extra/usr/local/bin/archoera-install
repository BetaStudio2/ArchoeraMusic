#!/bin/bash
# ArchoeraOS 安装器（Live → 目标磁盘）。
#
#   archoera-install <目标磁盘，如 /dev/vda>
#
# 行为：整盘擦除安装（GPT：512M ESP + 剩余 root/ext4）→ 格式化 → 复制 Live 系统
#      （只读层 + 本次会话改动）→ 生成 loader 条目（写入目标 root 的 PARTUUID，
#      去掉 Live 专用内核参数）→ 写 fstab / 重置 machine-id → 完成。
#
# 进度：写 /run/archoera-install/{step,percent,message,done,failed}，
#       供安装向导轮询（目录由 tmpfiles 预建并归属 kiosk 用户）。
set -euo pipefail

DISK="${1:?用法: archoera-install <目标磁盘>}"
STATE=/run/archoera-install
TARGET=/mnt/archoera
mkdir -p "$STATE"

step() { # step <百分比> <说明>
    printf '%s\n' "$2" > "$STATE/message"
    printf '%s\n' "$1" > "$STATE/percent"
    echo "[archoera-install] $1% — $2"
}
fail() {
    printf '%s\n' "$1" > "$STATE/failed"
    echo "[archoera-install] 失败: $1" >&2
    exit 1
}

[ -b "$DISK" ] || fail "不是块设备：$DISK"

# 目标盘分区名：/dev/vda → /dev/vda1；/dev/nvme0n1 → /dev/nvme0n1p1
case "$DISK" in
    *[0-9]) PART_PREFIX="${DISK}p" ;;
    *)      PART_PREFIX="$DISK" ;;
esac
ESP="${PART_PREFIX}1"
ROOT="${PART_PREFIX}2"

# 安全检查：不允许把 Live 自身所在磁盘作为目标。
LIVE_SRC="$(findmnt -n -o SOURCE / | sed 's/\[.*//')"
if [ -n "$LIVE_SRC" ] && [ "$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null | head -1)" = "$(basename "$DISK")" ]; then
    fail "目标磁盘正是当前 Live 介质：$DISK"
fi

step 3 "创建分区表（GPT：ESP + root）"
wipefs -a "$DISK"
sfdisk --wipe always "$DISK" >/dev/null <<EOF
label: gpt
name=ESP, size=512M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
name=ArchoeraOS, type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709
EOF
# 重读分区表（parted 未装；util-linux 的 blockdev + udevadm 即可）。
blockdev --rereadpt "$DISK" 2>/dev/null || true
udevadm settle || true

step 12 "格式化分区"
mkfs.fat -F32 -n ARCHOERAS "$ESP" >/dev/null
mkfs.ext4 -F -q -L ArchoeraOS "$ROOT"

step 20 "挂载目标系统"
mkdir -p "$TARGET"
mount "$ROOT" "$TARGET"
mkdir -p "$TARGET/boot"
mount "$ESP" "$TARGET/boot"

step 30 "复制系统文件（约 1-3 分钟）"
# -x 只跨本文件系统（Live root 是 overlay）；/boot 是独立 ESP，稍后单独复制。
# 排除运行时目录与目标挂载点，避免自复制。
rsync -aHAXx --delete \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/lost+found \
    / "$TARGET/"

step 70 "写入引导"
# 复制 Live 的 ESP 内容（内核 / initrd / systemd-boot），再按目标分区重写条目。
if findmnt -n /boot >/dev/null 2>&1; then
    cp -a /boot/. "$TARGET/boot/"
fi
NEWROOT="$(blkid -s PARTUUID -o value "$ROOT")"
NEWESP="$(blkid -s PARTUUID -o value "$ESP")"

# 取内核与 initrd（相对目标 ESP 的路径，systemd-boot 用 / 分隔）。
KERNEL=""
for cand in "$TARGET"/usr/lib/modules/*/vmlinuz "$TARGET"/boot/vmlinuz-*; do
    [ -f "$cand" ] || continue
    KERNEL="/${cand#"$TARGET"/boot/}"
    case "$cand" in "$TARGET"/boot/*) KERNEL="/${cand#"$TARGET"/boot/}" ;; esac
    break
done
# 若内核在 /usr/lib/modules 下而不在 ESP 上，则复制到 ESP 根再引用。
if [ -n "$KERNEL" ] && [ ! -f "$TARGET/boot$KERNEL" ]; then
    src=""
    for cand in "$TARGET"/usr/lib/modules/*/vmlinuz; do [ -f "$cand" ] && src="$cand" && break; done
    if [ -n "$src" ]; then
        cp -a "$src" "$TARGET/boot/vmlinuz-linux"
        KERNEL="/vmlinuz-linux"
    fi
fi

INITRDS=()
while IFS= read -r f; do
    rel="/${f#"$TARGET"/boot/}"
    cp -a "$f" "$TARGET/boot$rel" 2>/dev/null || true
    INITRDS+=("$rel")
done < <(find "$TARGET/boot" -maxdepth 3 -type f \( -name 'initrd' -o -name 'initrd-*' -o -name '*kernel-modules.initrd' \) 2>/dev/null | sort)
if [ "${#INITRDS[@]}" -eq 0 ]; then
    # 兜底：把 /usr/lib/modules 下的 initrd（若有）放到 ESP
    for cand in "$TARGET"/usr/lib/modules/*/initrd; do
        [ -f "$cand" ] || continue
        cp -a "$cand" "$TARGET/boot/initrd-linux"
        INITRDS=("/initrd-linux")
        break
    done
fi
[ -n "$KERNEL" ] || fail "未找到内核镜像（无法生成引导条目）"

# 只保留我们生成的条目，避免旧条目指回 Live 的 root。
rm -f "$TARGET"/boot/loader/entries/*.conf
mkdir -p "$TARGET/boot/loader/entries"
{
    echo "title   ArchoeraOS"
    echo "linux   $KERNEL"
    for i in "${INITRDS[@]}"; do echo "initrd  $i"; done
    echo "options root=PARTUUID=$NEWROOT rw splash plymouth.ignore-serial-consoles"
} > "$TARGET/boot/loader/entries/archoera.conf"

# systemd-boot：优先用 bootctl 安装（含随机种子/EFI 变量），失败则信任已复制的 ESP。
bootctl --esp-path="$TARGET/boot" install >/dev/null 2>&1 || true
printf 'default archoera.conf\ntimeout 0\n' > "$TARGET/boot/loader/loader.conf"

step 88 "收尾配置"
cat > "$TARGET/etc/fstab" <<EOF
UUID=$(blkid -s UUID -o value "$ROOT") /     ext4 rw,relatime 0 1
UUID=$(blkid -s UUID -o value "$ESP")  /boot vfat rw,relatime,fmask=0022,dmask=0022 0 2
EOF
# 目标系统不再是 Live：移除标记与 Live 专用单元。
# machine-id 要**重新生成一个有效值**（而不是留空）：留空会让 systemd-firstboot
# 在目标系统首启时跑文本向导、占住 tty1，kiosk 起不来。
rm -f "$TARGET/etc/archoera-live" \
      "$TARGET/etc/systemd/system/multi-user.target.wants/archoera-install.service" \
      "$TARGET/usr/lib/systemd/system/archoera-install.service"
rm -f "$TARGET/etc/machine-id"
systemd-machine-id-setup --root="$TARGET" >/dev/null 2>&1 \
    || printf '%s\n' "$(tr -d '-' </proc/sys/kernel/random/uuid)" > "$TARGET/etc/machine-id"
sync

step 96 "卸载"
umount "$TARGET/boot" 2>/dev/null || true
umount "$TARGET" 2>/dev/null || true

step 100 "安装完成"
: > "$STATE/done"
echo "[archoera-install] 完成：$DISK"
