#!/bin/bash
# ArchoeraOS 安装器 v2（Live → 目标磁盘）。
#
# 用法（由安装向导/桥接经 systemd 启动，建议不要手工调用）：
#   archoera-install                 # 读 /run/archoera-install/plan 与 secrets
#   archoera-install <磁盘>          # 兼容旧用法：整盘擦除 + ext4（不加密）
#
# 计划文件 /run/archoera-install/plan（key=value，键可省，走默认）：
#   disk=/dev/nvme0n1      目标磁盘（必填，兼容旧用法时来自命令行）
#   hostname=archoera      主机名
#   username=archoera      登录用户名（与镜像默认一致时不做改名）
#   locale=zh_CN.UTF-8     系统语言（镜像内已生成 en_US.UTF-8 / zh_CN.UTF-8）
#   timezone=Asia/Shanghai 时区（/usr/share/zoneinfo 下的名字）
#   keymap=us              控制台键盘布局（/etc/vconsole.conf）
#   fs=ext4|btrfs|xfs|f2fs 根文件系统（btrfs 会建 @/@home/@opt/@cache/@log 子卷）
#   swap=none|file         交换：无 / 交换文件（btrfs 子卷布局上不支持 file）
#   encrypt=0|1            整盘 root 分区用 LUKS2 加密
#   autologin=0|1          是否保持 tty1 自动登录进 kiosk（默认 1）
#
# 口令文件 /run/archoera-install/secrets（0600，由向导写入，绝不走命令行）：
#   luks_passphrase=...    encrypt=1 时必填
#   user_password=...      留空表示不设密码（kiosk 自动登录本就不需要）
#   root_password=...      留空保持 root 锁定
#
# 进度：写 /run/archoera-install/{percent,message,done,failed}（供向导轮询）。
set -euo pipefail
set -E  # ERR 陷阱在函数内也生效（配合 on_err 定位失败行）

STATE=/run/archoera-install
TARGET=/mnt/archoera
PLAN="$STATE/plan"
SECRETS="$STATE/secrets"
mkdir -p "$STATE"

# 未预期的失败（set -e 直接退出）原本只留下一个空的 failed 文件，无法定位。
# 这里用 ERR 陷阱把「行号 + 命令 + rc」写进 failed，并附 trace 尾部；set -E 让
# 函数内部也触发。
on_err() {
    local rc=$? line=$1 cmd=$2
    if [ ! -s "$STATE/failed" ]; then
        {
            printf '未预期失败 rc=%s（第 %s 行）：%s\n' "$rc" "$line" "$cmd"
            [ -s "$STATE/trace" ] && { echo "--- trace 尾部 ---"; tail -20 "$STATE/trace"; }
        } > "$STATE/failed"
    fi
}
trap 'on_err "$?" "$LINENO" "$BASH_COMMAND"' ERR

# 排障开关：存在 $STATE/debug 时开 xtrace（写 $STATE/trace），正常安装不留痕。
if [ -e "$STATE/debug" ]; then
    PS4='+${LINENO}: '
    exec 2> >(tee -a "$STATE/trace" >&2)
    set -x
fi

step() {
    printf '%s\n' "$2" > "$STATE/message"
    printf '%s\n' "$1" > "$STATE/percent"
    echo "[archoera-install] $1% — $2"
}
fail() {
    printf '%s\n' "${1:-未知失败（无消息）}" > "$STATE/failed"
    echo "[archoera-install] 失败: ${1:-未知失败（无消息）}" >&2
    exit 1
}

# ── 1) 读取计划 ────────────────────────────────────────────────────
DISK=""
HOSTNAME_="archoera"
USERNAME="archoera"
LOCALE_="en_US.UTF-8"
TIMEZONE="UTC"
KEYMAP="us"
FS="ext4"
SWAP="none"
ENCRYPT=0
AUTOLOGIN=1
LUKS_PASS=""
USER_PASS=""
ROOT_PASS=""

read_kv() { # read_kv <文件> <变量名>
    local file="$1" key="$2"
    [ -f "$file" ] || return 0
    local line
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$key="*) printf '%s' "${line#"$key"=}" ; return 0 ;;
        esac
    done < "$file"
}

if [ -f "$PLAN" ]; then
    DISK="$(read_kv "$PLAN" disk)"
    HOSTNAME_="$(read_kv "$PLAN" hostname)";   HOSTNAME_="${HOSTNAME_:-archoera}"
    USERNAME="$(read_kv "$PLAN" username)";    USERNAME="${USERNAME:-archoera}"
    LOCALE_="$(read_kv "$PLAN" locale)";       LOCALE_="${LOCALE_:-en_US.UTF-8}"
    TIMEZONE="$(read_kv "$PLAN" timezone)";    TIMEZONE="${TIMEZONE:-UTC}"
    KEYMAP="$(read_kv "$PLAN" keymap)";        KEYMAP="${KEYMAP:-us}"
    FS="$(read_kv "$PLAN" fs)";                FS="${FS:-ext4}"
    SWAP="$(read_kv "$PLAN" swap)";            SWAP="${SWAP:-none}"
    ENCRYPT="$(read_kv "$PLAN" encrypt)";      ENCRYPT="${ENCRYPT:-0}"
    AUTOLOGIN="$(read_kv "$PLAN" autologin)";  AUTOLOGIN="${AUTOLOGIN:-1}"
    LUKS_PASS="$(read_kv "$SECRETS" luks_passphrase)"
    USER_PASS="$(read_kv "$SECRETS" user_password)"
    ROOT_PASS="$(read_kv "$SECRETS" root_password)"
else
    # 兼容旧用法：archoera-install <磁盘>
    DISK="${1:-}"
fi

[ -n "$DISK" ] || fail "计划里缺少 disk=，且命令行也没给目标磁盘"
[ -b "$DISK" ] || fail "不是块设备：$DISK"
case "$FS" in ext4|btrfs|xfs|f2fs) ;; *) fail "不支持的文件系统：$FS（可选 ext4 / btrfs / xfs / f2fs）" ;; esac
case "$SWAP" in none|file) ;; *) fail "不支持的 swap：$SWAP（可选 none / file）" ;; esac
case "$ENCRYPT" in 0|1) ;; *) fail "encrypt 只能是 0 或 1" ;; esac
if [ "$ENCRYPT" = "1" ] && [ -z "$LUKS_PASS" ]; then
    fail "要求加密但 secrets 里没有 luks_passphrase"
fi
if [ "$SWAP" = "file" ] && [ "$FS" = "btrfs" ]; then
    fail "btrfs 子卷布局上不支持交换文件（请选 swap=none，或改用 ext4/xfs/f2fs）"
fi

# 目标盘分区名：/dev/vda → /dev/vda1；/dev/nvme0n1 → /dev/nvme0n1p1
case "$DISK" in
    *[0-9]) PART_PREFIX="${DISK}p" ;;
    *)      PART_PREFIX="$DISK" ;;
esac
ESP="${PART_PREFIX}1"
ROOTPART="${PART_PREFIX}2"
MAPPER="cryptroot"
ROOTDEV="$ROOTPART"

# 安全检查：不允许把 Live 自身所在磁盘作为目标。
LIVE_SRC="$(findmnt -n -o SOURCE / | sed 's/\[.*//')"
if [ -n "$LIVE_SRC" ] && [ "$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null | head -1)" = "$(basename "$DISK")" ]; then
    fail "目标磁盘正是当前 Live 介质：$DISK"
fi

cleanup() {
    umount "$TARGET/boot" 2>/dev/null || true
    for m in run sys proc dev; do umount "$TARGET/$m" 2>/dev/null || true; done
    if [ "$FS" = "btrfs" ]; then
        for m in var/log var/cache opt home; do umount "$TARGET/$m" 2>/dev/null || true; done
    fi
    umount "$TARGET" 2>/dev/null || true
    if [ "$ENCRYPT" = "1" ]; then cryptsetup close "$MAPPER" 2>/dev/null || true; fi
}
trap cleanup EXIT

# ── 1b) 仅列出候选磁盘（向导用；不修改任何东西）──────────────────────
if [ "${1:-}" = "--list" ]; then
    live_src="$(findmnt -n -o SOURCE / | sed 's/\[.*//')"
    live_disk="$(lsblk -no PKNAME "$live_src" 2>/dev/null | head -1)"
    {
        echo "# name|size_bytes|model|tran|is_live"
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            case "$name" in loop*|zram*|sr*|ram*|dm-*|md*) continue ;; esac
            size="$(lsblk -bdno SIZE "/dev/$name" 2>/dev/null | head -1)"; [ -n "$size" ] || size=0
            model="$(lsblk -dno MODEL "/dev/$name" 2>/dev/null | head -1 | tr -d '|')"
            tran="$(lsblk -dno TRAN "/dev/$name" 2>/dev/null | head -1)"
            live=0; [ "$name" = "$live_disk" ] && live=1
            printf '%s|%s|%s|%s|%s\n' "$name" "$size" "$model" "$tran" "$live"
        done < <(lsblk -dno NAME 2>/dev/null)
    } > "$STATE/devices"
    cat "$STATE/devices"
    exit 0
fi

# ── 2) 分区 ────────────────────────────────────────────────────────
step 3 "创建分区表（GPT：ESP 1G + root）"
wipefs -a "$DISK"
sfdisk --wipe always "$DISK" >/dev/null <<EOF
label: gpt
name=ESP, size=1G, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
name=ArchoeraOS, type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709
EOF
blockdev --rereadpt "$DISK" 2>/dev/null || true
udevadm settle || true
[ -b "$ESP" ] || fail "ESP 分区未出现：$ESP"
[ -b "$ROOTPART" ] || fail "root 分区未出现：$ROOTPART"

# ── 3) 加密（可选）与格式化 ────────────────────────────────────────
if [ "$ENCRYPT" = "1" ]; then
    step 8 "创建 LUKS2 容器（argon2id）"
    printf '%s' "$LUKS_PASS" | cryptsetup luksFormat --type luks2 --batch-mode \
        --pbkdf argon2id --key-file - "$ROOTPART" >/dev/null
    step 11 "打开加密容器"
    printf '%s' "$LUKS_PASS" | cryptsetup open --key-file - "$ROOTPART" "$MAPPER" >/dev/null
    ROOTDEV="/dev/mapper/$MAPPER"
fi

step 12 "格式化分区（ESP=vfat，root=$FS）"
mkfs.fat -F32 -n ARCHOERAS "$ESP" >/dev/null
case "$FS" in
    ext4)  mkfs.ext4 -F -q -L ArchoeraOS "$ROOTDEV" ;;
    btrfs) mkfs.btrfs -f -L ArchoeraOS "$ROOTDEV" >/dev/null ;;
    xfs)   mkfs.xfs -f -L ArchoeraOS "$ROOTDEV" >/dev/null ;;
    f2fs)  mkfs.f2fs -f -l ArchoeraOS "$ROOTDEV" >/dev/null ;;
    # 兜底：没有 default 分支的话，$FS 只要与上面不完全相等就会**静默什么都不做**，
    # 然后挂载必然报 bad superblock（本次 xfs/f2fs「失败」的可疑来源之一）。
    *)     fail "内部错误：$FS 没有对应的 mkfs 分支" ;;
esac
# 再确认格式化真的写进去了（blkid 认得出该 fs 才算数）。
GOT_FS="$(blkid -s TYPE -o value "$ROOTDEV" 2>/dev/null || true)"
[ "$GOT_FS" = "$FS" ] || fail "格式化后 blkid 报告的类型是 '$GOT_FS'，与要求的 $FS 不符"

step 20 "挂载目标系统"
mkdir -p "$TARGET"
ROOTFLAGS=""
BTRFS_SUBVOLS=0
if [ "$FS" = "btrfs" ]; then
    # 子卷布局与维护者本机同构：@（根）/ @home / @opt / @cache / @log。
    # @cache 与 @log 用 nodatacow：日志与缓存的写放大不值得压缩/COW。
    BTRFS_OPTS="noatime,compress=zstd,space_cache=v2,discard=async"
    mount "$ROOTDEV" "$TARGET"
    for sv in @ @home @opt @cache @log; do
        btrfs subvolume create "$TARGET/$sv" >/dev/null
    done
    umount "$TARGET"
    mount -o "subvol=@,$BTRFS_OPTS" "$ROOTDEV" "$TARGET"
    for d in home opt var/cache var/log; do mkdir -p "$TARGET/$d"; done
    mount -o "subvol=@home,$BTRFS_OPTS" "$ROOTDEV" "$TARGET/home"
    mount -o "subvol=@opt,$BTRFS_OPTS" "$ROOTDEV" "$TARGET/opt"
    mount -o "subvol=@cache,noatime,nodatacow,compress=zstd,discard=async" "$ROOTDEV" "$TARGET/var/cache"
    mount -o "subvol=@log,noatime,nodatacow,compress=zstd,discard=async" "$ROOTDEV" "$TARGET/var/log"
    # initrd 从 cmdline 挂根时不知道默认子卷，必须显式给 rootflags=subvol=@
    ROOTFLAGS="rootflags=subvol=@"
    BTRFS_SUBVOLS=1
else
    mount "$ROOTDEV" "$TARGET"
fi
mkdir -p "$TARGET/boot"
mount "$ESP" "$TARGET/boot"

# 交换文件（可选；放在根文件系统上，fstab 里带 nofail）
SWAPFILE=""
if [ "$SWAP" = "file" ]; then
    step 24 "创建交换文件（4G）"
    if fallocate -l 4G "$TARGET/swapfile" 2>/dev/null; then :; else
        dd if=/dev/zero of="$TARGET/swapfile" bs=1M count=4096 status=none
    fi
    chmod 600 "$TARGET/swapfile"
    mkswap "$TARGET/swapfile" >/dev/null
    SWAPFILE="/swapfile"
fi

# ── 4) 复制系统 ────────────────────────────────────────────────────
step 30 "复制系统文件（约 1-3 分钟）"
rsync -aHAXx --delete \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/lost+found \
    --exclude=/swapfile \
    / "$TARGET/"

# ── 5) 引导：标准 systemd-boot（kernel-install + BLS）───────────────
#
# 不再手工把内核/initrd 拷进 ESP：那样装出来的系统在内核升级后 ESP 永远停在
# 旧内核（且口令变更后没有重建 initrd 的路径）。这里走标准链路：
#   /etc/kernel/cmdline（BLS 条目的 options 来源）
#   kernel-install add <kver> <vmlinuz>
#     → 50-dracut.install：dracut 生成 initrd
#     → 90-loaderentry.install：写 $ESP/<machine-id>/<kver>/ 与 loader/entries/<machine-id>-<kver>.conf
# 之后 pacman 升级内核会由 systemd 的 hook 自动重跑同一条链路（见
# /etc/kernel/install.conf 的 layout=bls + initrd_generator=dracut）。
step 70 "写入引导（systemd-boot + kernel-install/BLS）"
NEWROOT_PARTUUID="$(blkid -s PARTUUID -o value "$ROOTPART")"
NEWROOT_UUID="$(blkid -s UUID -o value "$ROOTDEV")"
NEWESP_UUID="$(blkid -s UUID -o value "$ESP")"

# machine-id 必须先生成好：BLS 目录名用它，留空还会让首启弹 systemd-firstboot。
rm -f "$TARGET/etc/machine-id"
systemd-machine-id-setup --root="$TARGET" >/dev/null 2>&1 \
    || printf '%s\n' "$(tr -d '-' </proc/sys/kernel/random/uuid)" > "$TARGET/etc/machine-id"

# root 参数：加密时用 mapper（rd.luks.name 交给 systemd-initrd 解锁）；btrfs 带 rootflags。
if [ "$ENCRYPT" = "1" ]; then
    ROOT_OPTS="root=/dev/mapper/$MAPPER rd.luks.name=$NEWROOT_PARTUUID=$MAPPER"
else
    ROOT_OPTS="root=PARTUUID=$NEWROOT_PARTUUID"
fi
[ -n "$ROOTFLAGS" ] && ROOT_OPTS="$ROOT_OPTS $ROOTFLAGS"
CMDLINE="$ROOT_OPTS rw splash plymouth.ignore-serial-consoles"
mkdir -p "$TARGET/etc/kernel"
printf '%s\n' "$CMDLINE" > "$TARGET/etc/kernel/cmdline"
# 去掉 Live 的引导 token（mkosi 构建期写入的 "archoera-live"）：留着的话
# kernel-install 会继续用它命名 $ESP/<token>/<kver>/ 与条目，装出来的系统带着
# "live" 字样、多台/多次安装还会互相覆盖同名条目。删掉后自动回落到 machine-id。
rm -f "$TARGET/etc/kernel/entry-token"

# fstab 必须在 kernel-install 之前写好：dracut 的 use_fstab=yes 与 bootctl 的
# ESP 判定都读它（写入顺序错了会拿到 Live 的空 fstab）。
{
    if [ "$FS" = "btrfs" ]; then
        OPTS="noatime,compress=zstd,space_cache=v2,discard=async"
        echo "UUID=$NEWROOT_UUID /           btrfs subvol=/@,$OPTS 0 1"
        echo "UUID=$NEWROOT_UUID /home       btrfs subvol=/@home,$OPTS 0 2"
        echo "UUID=$NEWROOT_UUID /opt        btrfs subvol=/@opt,$OPTS 0 2"
        echo "UUID=$NEWROOT_UUID /var/cache  btrfs subvol=/@cache,noatime,nodatacow,compress=zstd,discard=async 0 2"
        echo "UUID=$NEWROOT_UUID /var/log    btrfs subvol=/@log,noatime,nodatacow,compress=zstd,discard=async 0 2"
    else
        FSTYPE_OPTS="rw,relatime"
        [ "$FS" = "f2fs" ] && FSTYPE_OPTS="rw,relatime,compress_algorithm=zstd"
        echo "UUID=$NEWROOT_UUID /     $FS $FSTYPE_OPTS 0 1"
    fi
    echo "UUID=$NEWESP_UUID  /boot vfat rw,relatime,fmask=0022,dmask=0022 0 2"
    [ -n "$SWAPFILE" ] && echo "$SWAPFILE none swap defaults,nofail 0 0"
} > "$TARGET/etc/fstab"

# Live 带过来的旧引导产物清掉（避免 ESP 里留着 Live 的内核/initrd 与旧条目）。
rm -rf "$TARGET/boot/loader/entries"
rm -f "$TARGET/boot/vmlinuz-linux" "$TARGET/boot/initrd-linux"

# systemd-boot 本体（含可移动介质回退路径 EFI/BOOT/BOOTX64.EFI）。
if ! bootctl --esp-path="$TARGET/boot" install >/dev/null 2>&1; then
    step 72 "bootctl install 失败，尝试只复制引导文件"
    mkdir -p "$TARGET/boot/EFI/BOOT" "$TARGET/boot/EFI/systemd"
    cp -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi "$TARGET/boot/EFI/systemd/" 2>/dev/null || true
    cp -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi "$TARGET/boot/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
fi

# 在 chroot 里生成 initrd 与条目：kernel-install 需要 /proc /sys /dev /run。
KVER=""
for d in "$TARGET"/usr/lib/modules/*/; do
    [ -d "$d" ] || continue
    KVER="$(basename "$d")"
    break
done
[ -n "$KVER" ] || fail "目标系统里没有 /usr/lib/modules/<版本>（无法生成 initrd）"
[ -x "$TARGET/usr/bin/dracut" ] || fail "目标系统缺少 dracut（initrd 生成器）"

step 76 "生成 initrd 与引导条目（dracut + kernel-install，视机器性能 1-3 分钟）"
for m in dev proc sys run; do
    mkdir -p "$TARGET/$m"
    mount --bind "/$m" "$TARGET/$m" 2>/dev/null || true
done
chroot "$TARGET" /usr/bin/env -i \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin \
    HOME=/root TERM=dumb LANG=C \
    kernel-install add "$KVER" "/usr/lib/modules/$KVER/vmlinuz" \
    || fail "kernel-install 失败（initrd/引导条目未生成）"
for m in run sys proc dev; do umount "$TARGET/$m" 2>/dev/null || true; done

ENTRY="$(ls "$TARGET/boot/loader/entries" 2>/dev/null | head -1)"
[ -n "$ENTRY" ] || fail "kernel-install 没有生成引导条目"
# ⚠ 必须确认 initrd 真生成了：dracut 失败时 kernel-install 仍可能留下条目，
# 之前出现过「报 100% 完成、装出来的系统却没有 initrd、根本起不来」。
grep -qE '^initrd' "$TARGET/boot/loader/entries/$ENTRY" || fail "引导条目里没有 initrd"
while read -r _ initrd_path; do
    case "$initrd_path" in
        /*) [ -f "$TARGET/boot$initrd_path" ] || fail "引导条目引用的 initrd 不存在：$initrd_path" ;;
        *)  [ -f "$TARGET/boot/$initrd_path" ] || fail "引导条目引用的 initrd 不存在：$initrd_path" ;;
    esac
done < <(grep -E '^initrd' "$TARGET/boot/loader/entries/$ENTRY")
printf 'default %s\ntimeout 0\neditor no\n' "$ENTRY" > "$TARGET/boot/loader/loader.conf"

# ── 6) 收尾配置 ────────────────────────────────────────────────────
step 88 "写 crypttab / 本地化 / 用户"
# 加密时写 crypttab（systemd 会用它在 initrd 阶段解锁）。
if [ "$ENCRYPT" = "1" ]; then
    {
        echo "# <name> <device> <password> <options>"
        echo "$MAPPER PARTUUID=$NEWROOT_PARTUUID none luks,discard"
    } > "$TARGET/etc/crypttab"
else
    rm -f "$TARGET/etc/crypttab"
fi

# 语言 / 时区 / 键盘
printf 'LANG=%s\n' "$LOCALE_" > "$TARGET/etc/locale.conf"
if [ -e "$TARGET/usr/share/zoneinfo/$TIMEZONE" ]; then
    ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGET/etc/localtime"
fi
printf 'KEYMAP=%s\n' "$KEYMAP" > "$TARGET/etc/vconsole.conf"

# 主机名
printf '%s\n' "$HOSTNAME_" > "$TARGET/etc/hostname"
{
    echo "127.0.0.1 localhost"
    echo "::1       localhost"
    echo "127.0.1.1 $HOSTNAME_.localdomain $HOSTNAME_"
} > "$TARGET/etc/hosts"

# 用户名：默认与镜像一致（archoera）时无需改动；否则改名并同步相关配置。
if [ "$USERNAME" != "archoera" ]; then
    step 90 "重命名用户 archoera → $USERNAME"
    groupmod -R "$TARGET" -n "$USERNAME" archoera 2>/dev/null || true
    usermod -R "$TARGET" -l "$USERNAME" -d "/home/$USERNAME" -m archoera 2>/dev/null || true
    # 镜像里所有绝对路径的引用（tmpfiles/skel 播种）一起改掉。
    grep -rl "/home/archoera" "$TARGET/usr/lib/tmpfiles.d" "$TARGET/usr/local/bin" 2>/dev/null \
        | while IFS= read -r f; do sed -i "s#/home/archoera#/home/$USERNAME#g" "$f"; done
    sed -i "s/^archoera:/$USERNAME:/" "$TARGET/etc/passwd" 2>/dev/null || true
fi

# 自动登录（kiosk 形态默认开启）
AUTOLOGIN_FILE="$TARGET/etc/systemd/system/getty@tty1.service.d/autologin.conf"
if [ "$AUTOLOGIN" = "1" ]; then
    mkdir -p "$(dirname "$AUTOLOGIN_FILE")"
    cat > "$AUTOLOGIN_FILE" <<EOF
# ArchoeraOS：tty1 以 $USERNAME 自动登录并直接进入 kiosk 会话。
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin $USERNAME %I \$TERM
EOF
else
    rm -f "$AUTOLOGIN_FILE"
fi

# 口令（只在给了才设；chpasswd 的 --root 直接改目标盘）
if [ -n "$USER_PASS" ]; then
    printf '%s:%s\n' "$USERNAME" "$USER_PASS" | chpasswd -R "$TARGET" || fail "设置用户密码失败"
fi
if [ -n "$ROOT_PASS" ]; then
    printf 'root:%s\n' "$ROOT_PASS" | chpasswd -R "$TARGET" || fail "设置 root 密码失败"
fi

# 目标系统不再是 Live。
rm -f "$TARGET/etc/archoera-live" \
      "$TARGET/etc/systemd/system/multi-user.target.wants/archoera-install.service" \
      "$TARGET/usr/lib/systemd/system/archoera-install.service" \
      "$TARGET/usr/local/bin/archoera-install"
rm -rf "$TARGET/usr/lib/systemd/system/multi-user.target.d/20-archoera-kmscon.conf"
sync

step 96 "卸载"
for m in run sys proc dev; do umount "$TARGET/$m" 2>/dev/null || true; done
umount "$TARGET/boot" 2>/dev/null || true
if [ "$FS" = "btrfs" ]; then
    for m in var/log var/cache opt home; do umount "$TARGET/$m" 2>/dev/null || true; done
fi
umount "$TARGET" 2>/dev/null || true
if [ "$ENCRYPT" = "1" ]; then cryptsetup close "$MAPPER" 2>/dev/null || true; fi
trap - EXIT

step 100 "安装完成"
: > "$STATE/done"
echo "[archoera-install] 完成：$DISK（fs=$FS encrypt=$ENCRYPT user=$USERNAME host=$HOSTNAME_）"
